# Optional environment overrides for src/main/resources/application.conf.
# Defaults already work locally; uncomment only values you want to override.
# Export with: set -a; . ./.env; set +a
# Compose also reads DB_PASSWORD; the database role password must match.
# HOST=127.0.0.1
# PORT=8080
# DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/coffee_journal
# DB_USER=coffee_journal
# DB_PASSWORD=local-coffee-journal
# OWNER_ID=00000000-0000-0000-0000-000000000001
# DB_POOL_SIZE=4
# DB_PARALLELISM=4
